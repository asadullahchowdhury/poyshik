<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: just the app background, no icon tile.
         The animated logo intro is drawn by Flutter (lib/app/intro.dart). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/poyshik_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/poyshik_bg</item>
    </style>
</resources>
