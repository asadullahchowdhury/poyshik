# Public origin of the deployed site (canonical URLs, Open Graph).
SITE_URL=https://poyshik.example

# GitHub Pages project sites only: "/<repository-name>". Leave empty for
# Vercel or a custom domain.
BASE_PATH=

# Download links: leave empty until they exist. The page shows "Coming soon"
# instead of a broken or invented link.
PUBLIC_PLAY_STORE_URL=
PUBLIC_APK_URL=
# Version label shown next to a direct APK download, e.g. 1.1.0
PUBLIC_APK_VERSION=

# Optional contact address shown in the footer.
PUBLIC_CONTACT_EMAIL=
