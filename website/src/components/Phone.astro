---
// A device frame around a real app screenshot (rendered from the Flutter
// widgets with demo data; see /screenshots in the repo).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** One screenshot. Omit and pass children instead to stack several screens. */
  src?: ImageMetadata;
  alt?: string;
  width?: number;
  eager?: boolean;
  class?: string;
}
const { src, alt = '', width = 320, eager = false, class: className = '' } = Astro.props;
---

<figure class:list={['phone', className]} style={`--w:${width}px`}>
  <div class="phone__screen">
    {src ? (
      <Image
        src={src}
        alt={alt}
        widths={[360, 540, 720, 1080]}
        sizes={`(max-width: 600px) 70vw, ${width}px`}
        format="webp"
        quality={82}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    ) : (
      <slot />
    )}
  </div>
</figure>

<style>
  .phone {
    margin: 0;
    width: min(var(--w), 78vw);
    aspect-ratio: 1200 / 2598;
    padding: 10px;
    border-radius: 46px;
    background: linear-gradient(160deg, #1a2a22, #07130e);
    box-shadow:
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.06),
      var(--shadow-phone);
    position: relative;
  }
  .phone::before {
    /* camera punch-hole */
    content: '';
    position: absolute;
    top: 21px;
    left: 50%;
    width: 11px;
    height: 11px;
    margin-left: -5.5px;
    border-radius: 50%;
    background: #050b08;
    z-index: 2;
  }
  .phone__screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 37px;
    overflow: hidden;
    background: var(--paper);
    /* Keep the rounded clip while children animate transforms (Safari). */
    isolation: isolate;
  }
  .phone__screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
