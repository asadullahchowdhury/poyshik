---
import logo from '../assets/brand/poyshik-logo-p-dark.svg?raw';
import DownloadButton from './DownloadButton.astro';
import { site } from '../config/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const { creator } = site;
// Brush signature (from Rahat's portfolio), used as a mask so it can take the
// Poyshik marigold. Two lines, "Rahat" over "Chowdhury", written one after the
// other. Swap the file to change it (keep the two-line layout, or adjust
// --split below).
const signatureUrl = `${base}brand/rahat-signature.webp`;

const explore = [
  { href: `${base}#how`, label: 'How it works' },
  { href: `${base}#features`, label: 'Features' },
  { href: `${base}#insights`, label: 'Insights' },
  { href: `${base}#privacy`, label: 'Privacy & offline' },
];
const legal = [
  { href: `${base}privacy/`, label: 'Privacy policy' },
  { href: `${base}terms/`, label: 'Terms' },
  ...(site.contactEmail ? [{ href: `mailto:${site.contactEmail}`, label: 'Contact' }] : []),
];
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <a href={base} class="footer__logo" aria-label="Poyshik home" set:html={logo} />
      <p class="footer__tagline">{site.tagline}</p>
      <p class="footer__about">
        A calm expense tracker for {site.platform}. Offline, no account, your data stays on your
        phone.
      </p>
      <DownloadButton variant="accent" />
    </div>

    <nav class="footer__col" aria-labelledby="footer-explore">
      <h2 id="footer-explore">Explore</h2>
      <ul>
        {explore.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer__col" aria-labelledby="footer-legal">
      <h2 id="footer-legal">Legal</h2>
      <ul>
        {legal.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- The name, big: the P lands, then each letter of "oyshik" rises in turn,
       and the whole word drifts up as the page ends. -->
  <div
    class="footer__giant"
    data-reveal
    data-progress="view"
    data-static="1"
    aria-hidden="true"
    set:html={logo}
  />

  <div class="container footer__bottom">
    <p class="footer__legal">
      © {site.year} {site.name}. All rights reserved.
    </p>
    <div class="footer__maker">
      <span class="footer__maker-label">Designed &amp; built by</span>
      <span class="sr-only">{creator.name}</span>
      {creator.url ? (
        <a
          class="footer__signature"
          href={creator.url}
          rel="noopener"
          aria-label={creator.name}
          data-reveal
          style={`--sig:url('${signatureUrl}')`}
        >
          <span class="footer__ink footer__ink--first" />
          <span class="footer__ink footer__ink--last" />
          <span class="footer__tip" />
        </a>
      ) : (
        <span
          class="footer__signature"
          data-reveal
          aria-hidden="true"
          style={`--sig:url('${signatureUrl}')`}
        >
          <span class="footer__ink footer__ink--first" />
          <span class="footer__ink footer__ink--last" />
          <span class="footer__tip" />
        </span>
      )}
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--forest-night);
    color: var(--on-forest-muted);
    padding: 96px 0 28px;
    overflow: hidden;
    position: relative;
  }

  /* Top: brand and call to action, then two link columns. */
  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }
  .footer__logo {
    display: block;
    height: 34px;
    width: fit-content;
  }
  .footer__logo :global(svg) {
    height: 100%;
    width: auto;
  }
  .footer__tagline {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.15;
    color: var(--on-forest);
  }
  .footer__about {
    margin: 10px 0 24px;
    max-width: 34ch;
    font-size: 0.95rem;
  }
  .footer__col h2 {
    margin: 6px 0 16px;
    font: 600 0.75rem/1 var(--font-ui);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-forest);
  }
  .footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  a {
    text-decoration: none;
    color: inherit;
  }
  .footer__col a {
    transition: color 0.2s var(--ease);
  }
  .footer__col a:hover,
  .footer__col a:focus-visible {
    color: var(--on-forest);
  }

  /* The giant name. */
  .footer__giant {
    --p: 0;
    margin: 72px auto 0;
    padding: 0 var(--gutter);
    max-width: calc(var(--max) + 2 * var(--gutter));
    transform: translateY(calc((1 - var(--p)) * 18%));
    /* Its own entrance below, not the generic fade. */
    opacity: 1 !important;
  }
  .footer__giant :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .footer__giant :global(.logo-mark path:first-child),
  .footer__giant :global(.logo-letter) {
    fill: rgba(244, 238, 226, 0.1);
  }
  .footer__giant :global(.logo-mark path:last-child) {
    fill: rgba(233, 176, 78, 0.32);
  }
  .footer__giant :global(.logo-mark),
  .footer__giant :global(.logo-letter) {
    transform-box: fill-box;
  }
  .footer__giant :global(.logo-mark) {
    transform-origin: 30% 80%;
  }
  .footer__giant :global(.logo-letter) {
    transform-origin: 50% 100%;
  }
  :global(.js) .footer__giant :global(.logo-mark) {
    opacity: 0;
    transform: translateY(18%) scale(0.92);
  }
  :global(.js) .footer__giant :global(.logo-letter) {
    opacity: 0;
    transform: translateY(45%);
  }
  :global(.js) .footer__giant:global(.is-visible) :global(.logo-mark) {
    animation: giant-in 1.1s var(--ease) 0.1s forwards;
  }
  :global(.js) .footer__giant:global(.is-visible) :global(.logo-letter) {
    animation: giant-in 1s var(--ease) calc(0.45s + var(--i) * 0.09s) forwards;
  }
  @keyframes giant-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Bottom bar: legal line, and the maker's signature. */
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid rgba(244, 238, 226, 0.1);
  }
  .footer__legal {
    margin: 0;
    font-size: 0.85rem;
  }
  .footer__maker {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .footer__maker-label {
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The signature shape masks a warm marigold gradient, tilted like a
     sign-off. Two ink layers share the mask: the first covers the "Rahat"
     line, the second "Chowdhury"; each is written left to right in turn. */
  .footer__signature {
    --split: 47%;
    position: relative;
    display: block;
    width: clamp(150px, 16vw, 190px);
    aspect-ratio: 480 / 260;
    rotate: -4deg;
    /* Its own entrance below, not the generic fade. */
    opacity: 1 !important;
    transform: none !important;
  }
  .footer__ink {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      #f6e3b8 0%,
      var(--marigold-light) 55%,
      var(--marigold) 100%
    );
    filter: drop-shadow(0 0 12px rgba(233, 176, 78, 0.25));
    -webkit-mask: var(--sig) left center / contain no-repeat;
    mask: var(--sig) left center / contain no-repeat;
  }
  .footer__ink--first {
    clip-path: inset(-10% 0 calc(100% - var(--split)) 0);
  }
  .footer__ink--last {
    clip-path: inset(var(--split) 0 -10% 0);
  }
  .footer__tip {
    position: absolute;
    top: 25%;
    left: 0;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(255, 240, 210, 0.6),
      rgba(233, 176, 78, 0.2) 45%,
      transparent
    );
    opacity: 0;
    pointer-events: none;
  }
  :global(.js) .footer__ink--first {
    clip-path: inset(-10% 100% calc(100% - var(--split)) 0);
  }
  :global(.js) .footer__ink--last {
    clip-path: inset(var(--split) 100% -10% 0);
  }
  :global(.js) .footer__signature:global(.is-visible) .footer__ink--first {
    animation: sign-first 0.95s cubic-bezier(0.45, 0, 0.55, 1) 0.25s forwards;
  }
  :global(.js) .footer__signature:global(.is-visible) .footer__ink--last {
    animation: sign-last 1.25s cubic-bezier(0.45, 0, 0.55, 1) 1.3s forwards;
  }
  :global(.js) .footer__signature:global(.is-visible) .footer__tip {
    animation: sign-tip 2.3s linear 0.25s forwards;
  }
  @keyframes sign-first {
    to {
      clip-path: inset(-10% 0 calc(100% - var(--split)) 0);
    }
  }
  @keyframes sign-last {
    to {
      clip-path: inset(var(--split) 0 -10% 0);
    }
  }
  /* The pen rides the first line, lifts, then writes the second. */
  @keyframes sign-tip {
    0% {
      top: 25%;
      left: 16%;
      opacity: 1;
    }
    40% {
      top: 25%;
      left: 86%;
      opacity: 1;
    }
    45% {
      top: 25%;
      left: 86%;
      opacity: 0;
    }
    46% {
      top: 72%;
      left: 0;
      opacity: 0;
    }
    50% {
      top: 72%;
      left: 0;
      opacity: 1;
    }
    94% {
      top: 72%;
      left: 100%;
      opacity: 1;
    }
    100% {
      top: 72%;
      left: 100%;
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .footer {
      padding-top: 72px;
    }
    .footer__top {
      grid-template-columns: 1fr 1fr;
      gap: 40px 24px;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
    .footer__giant {
      margin-top: 56px;
    }
    .footer__bottom {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .footer__ink--first,
    :global(.js) .footer__ink--last {
      animation: none !important;
    }
    :global(.js) .footer__ink--first {
      clip-path: inset(-10% 0 calc(100% - var(--split)) 0);
    }
    :global(.js) .footer__ink--last {
      clip-path: inset(var(--split) 0 -10% 0);
    }
    .footer__tip {
      display: none;
    }
    :global(.js) .footer__giant :global(.logo-mark),
    :global(.js) .footer__giant :global(.logo-letter) {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }
</style>
