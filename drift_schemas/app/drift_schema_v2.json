  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"color_index\" INTEGER NOT NULL DEFAULT 0, \"opening_balance\" INTEGER NOT NULL DEFAULT 0, \"currency\" TEXT NOT NULL DEFAULT 'BDT', \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"color_index\" INTEGER NOT NULL DEFAULT 0, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"system_key\" TEXT NULL UNIQUE, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recurring_rules",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_rules\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL, \"account_id\" TEXT NOT NULL REFERENCES accounts (id), \"to_account_id\" TEXT NULL REFERENCES accounts (id), \"category_id\" TEXT NULL REFERENCES categories (id), \"note\" TEXT NULL, \"frequency\" TEXT NOT NULL, \"interval\" INTEGER NOT NULL DEFAULT 1, \"start_date\" TEXT NOT NULL, \"next_due\" TEXT NOT NULL, \"end_date\" TEXT NULL, \"auto_log\" INTEGER NOT NULL DEFAULT 1 CHECK (\"auto_log\" IN (0, 1)), \"is_paused\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_paused\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (amount > 0), CHECK (interval >= 1), CHECK ((type = 'transfer' AND to_account_id IS NOT NULL AND category_id IS NULL AND to_account_id <> account_id) OR (type IN ('expense', 'income') AND category_id IS NOT NULL AND to_account_id IS NULL)));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL, \"account_id\" TEXT NOT NULL REFERENCES accounts (id), \"to_account_id\" TEXT NULL REFERENCES accounts (id), \"category_id\" TEXT NULL REFERENCES categories (id), \"occurred_at\" TEXT NOT NULL, \"note\" TEXT NULL, \"recurring_id\" TEXT NULL REFERENCES recurring_rules (id), PRIMARY KEY (\"id\"), CHECK (amount > 0), CHECK ((type = 'transfer' AND to_account_id IS NOT NULL AND category_id IS NULL AND to_account_id <> account_id) OR (type IN ('expense', 'income') AND category_id IS NOT NULL AND to_account_id IS NULL)));"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"id\" TEXT NOT NULL, \"category_id\" TEXT NULL REFERENCES categories (id), \"amount\" INTEGER NOT NULL, \"period\" TEXT NOT NULL DEFAULT 'monthly', PRIMARY KEY (\"id\"), CHECK (amount > 0));"
        }
      ]
    },
    {
